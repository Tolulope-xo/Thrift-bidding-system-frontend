# Backend API URL (include the /api suffix)
VITE_API_URL=http://localhost:5000/api

# Set to "off" when the backend runs serverless (e.g. Vercel), which can't hold
# WebSocket connections — pages then poll for bids and notifications instead.
# VITE_REALTIME=off

# Canonical public origin used for canonical/OG URLs, JSON-LD, robots.txt and
# sitemap.xml (no trailing slash). Defaults to the Vercel URL below.
# VITE_SITE_URL=https://thrift-bidding-system-frontend.vercel.app
